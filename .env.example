# ============================================================
# 币安 U 本位合约自动量化交易系统 - 环境配置
# ============================================================
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ── 币安 API ──
# 环境: testnet (测试网) | prod (实盘) | demo
BINANCE_API_ENV=testnet

# API Key 和 Secret（从币安后台获取）
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# 实盘专用 Key（可选，与上面不同时使用）
BINANCE_PROD_API_KEY=
BINANCE_PROD_SECRET_KEY=

# ── 通知推送 ──
# Telegram Bot Token（从 @BotFather 获取）
TELEGRAM_BOT_TOKEN=
# 接收通知的 Chat ID（从 @userinfobot 获取）
TELEGRAM_CHAT_ID=

# ── 系统设置 ──
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 交易模式: dry_run (模拟) | live (实盘)
TRADE_MODE=dry_run
# 主循环间隔（秒）
CYCLE_INTERVAL=60
# 信号冷却时间（秒），同一币种最短间隔
SIGNAL_COOLDOWN=300
