# ============================================================
# 量化交易系统 · 环境配置模板
# 用法: cp .env.example .env  然后填入你的 API Key
# ============================================================

# ── API Key（必须填写） ──
# 测试网 Key: https://testnet.binancefuture.com
BINANCE_API_KEY=YOUR_TESTNET_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_TESTNET_SECRET_KEY_HERE

# ── 实盘 API Key（仅在 BINANCE_API_ENV=prod 时使用） ──
# 如不填写，实盘模式下将使用上面的 Key（不推荐）
BINANCE_PROD_API_KEY=YOUR_PROD_API_KEY_HERE
BINANCE_PROD_SECRET_KEY=YOUR_PROD_SECRET_KEY_HERE

# ── 环境选择 ──
# testnet = 币安测试网（模拟交易，默认）
# prod    = 币安实盘（真实资金，谨慎使用）
BINANCE_API_ENV=testnet

# ── 杠杆默认值 ──
DEFAULT_LEVERAGE=3

# ── 交易精度（小数位数） ──
# BTC = 3位, ETH = 2位, 其他币种见交易所规则
QTY_PRECISION_BTC=3
QTY_PRECISION_ETH=2
QTY_PRECISION_DEFAULT=2
